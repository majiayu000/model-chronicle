{
  "name": "model-chronicle",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun scripts/build-data.ts",
    "pages": "bun scripts/build-pages.ts",
    "audit:sources": "bun scripts/check-sources.ts",
    "dev": "bun run data && bun run pages && vite",
    "build": "bun run data && bun run pages && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun run data && bun run pages && vitest run",
    "test:unit": "vitest run",
    "format:ui": "prettier --write index.html 'public/graph-v2/chronicle*.js' 'public/graph-v2/catalog-*.js' public/graph-v2/price-chart.js src/design/application.js",
    "format:check": "prettier --check index.html 'public/graph-v2/chronicle*.js' 'public/graph-v2/catalog-*.js' public/graph-v2/price-chart.js src/design/application.js"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
