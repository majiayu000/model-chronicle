{
  "name": "model-chronicle",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun scripts/build-data.ts",
    "pages": "bun scripts/build-pages.ts",
    "audit:sources": "bun scripts/check-sources.ts",
    "dev": "bun run data && bun run pages && vite",
